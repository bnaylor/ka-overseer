{
  "repo": "your-org/your-repo",
  "human": "the human",
  "human_short": "human",
  "session_pattern": "^(worker-|planner|overseer)",
  "gating_bot": "your-review-bot",
  "advisory_bot": "",
  "non_human_reviewers": [],
  "session_post_pattern": "",
  "round_cap": 6,
  "ignored_check_contexts": [
    "tide"
  ],
  "scope_queries": {
    "mine": [
      "--author",
      "@me"
    ],
    "review_requested": [
      "--search",
      "review-requested:@me"
    ],
    "reviewed": [
      "--search",
      "reviewed-by:@me -author:@me"
    ]
  },
  "notify": "osascript",
  "cwd_prefixes": [
    "/path/to/your/checkouts"
  ]
}
